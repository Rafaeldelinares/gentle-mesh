# security-gates.allowlist — Gentle Mesh & RFC-002 Security Gate Allowlist
# Format: path:grep_pattern || phase || reason
# path         = directory prefix or file, matched by prefix
# grep_pattern = ERE matched against file content with grep -E
# phase        = milestone (v1.0.2, v1.0.3), phase (F1, F2), or "permanent"
# reason       = human-readable justification
# Lines starting with # and blank lines are ignored.
#
# NOTE: Artifact problems (.db, .crt, .srl, .csr in git) are NOT allowlist
# entries. They must be fixed at the source with git rm --cached and .gitignore.
# The DB/artifact gate checks git ls-files --cached regardless of allowlist.

# ── Permanent Gate Exceptions (S1: InsecureSkipVerify) ──────────────────────
pkg/tlsutil/:InsecureSkipVerify                  || permanent || centralized dev-insecure TLS configuration

# ── Milestone v1.0.2 / Phase F1 (S1): InsecureSkipVerify ──────────────────────
integration/testscenario/:InsecureSkipVerify     || F1 || test harness: self-signed certs
integration/agent/client.go:InsecureSkipVerify   || F1 || WithInsecureSkipVerify dev helper
integration/agent/tls_test.go:InsecureSkipVerify || F1 || test verifies TLS 1.1 rejection (S9)
pkg/shell/mesh.go:InsecureSkipVerify             || F1 || dev stub: file not imported in any binary

# ── Phase F2: exec sh -c (eliminated in F2 by direct exec.Command) ─────────────
# All sh -c calls are replaced with direct exec.Command in Phase F2.
# Phase 0b resolves this for test infrastructure by adding //go:build testharness,
# but the sh -c pattern remains in source until F2 replaces it.
pkg/shell/:exec.Command.*"sh".*"-c"               || F2 || stub package, direct exec in Phase 2
integration/agent/server.go:exec.Command.*"sh".*"-c" || F2 || handleExecute + assertion evaluation
integration/testscenario/:exec.Command.*"sh".*"-c"  || F2 || docker exec and fixture setup in tests
